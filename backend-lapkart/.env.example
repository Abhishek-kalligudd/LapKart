# ========================================================
# RENDER ENVIRONMENT VARIABLES CONFIGURATION
# Set these in Render Dashboard -> Web Service -> Environment
# ========================================================

# MySQL Database credentials (Aiven Cloud)
DB_PASSWORD=your_aiven_database_password_here
SPRING_DATASOURCE_URL=jdbc:mysql://lapkart-abhuk-16.f.aivencloud.com:23046/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin

# Security & JWT
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: Custom domain for frontend if different from *.vercel.app
FRONTEND_URL=https://your-custom-domain.com
